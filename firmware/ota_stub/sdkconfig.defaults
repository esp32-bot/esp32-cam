# Ultra-minimal ESP32-CAM rescue stub (no LCD, no speaker, no PMIC, no camera driver).
CONFIG_IDF_TARGET="esp32"
CONFIG_ESP32_REV_MIN_1=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../partitions_cam_compact.csv"

CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y
CONFIG_FREERTOS_HZ=200

CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_ERROR=y
CONFIG_LWIP_IPV6=n
CONFIG_LWIP_ESP_GRATUITOUS_ARP=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_NEWLIB_NANO_FORMAT=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# Disable WPA3 ECC / Enterprise / 11kv in tiny rescue stub (saves ~80-100 KB of tfpsacrypto!)
# Keep ESP_WIFI_MBEDTLS_CRYPTO=y (required by IDF 6.1 wpa_supplicant SHA1); drop WPA3/ECC/TLS.
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n
CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_11KV_SUPPORT=n
CONFIG_ESP_WIFI_GCMP_SUPPORT=n
CONFIG_ESP_WIFI_GMAC_SUPPORT=n
CONFIG_ESP_WIFI_SLP_IRAM_OPT=n
CONFIG_LWIP_DHCP_DOES_ARP_CHECK=n
CONFIG_LWIP_IGMP=n
CONFIG_LWIP_NETIF_LOOPBACK=n
CONFIG_MBEDTLS_TLS_ENABLED=n
CONFIG_MBEDTLS_SSL_PROTO_TLS1_2=n
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=n
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_MBEDTLS_ECP_C=n
CONFIG_MBEDTLS_GCM_C=n
CONFIG_MBEDTLS_SHA512_C=n
CONFIG_MBEDTLS_SHA384_C=n
CONFIG_MBEDTLS_AES_ROM_TABLES=n
CONFIG_MBEDTLS_AES_FEWER_TABLES=y
CONFIG_MBEDTLS_HARDWARE_MPI=n
