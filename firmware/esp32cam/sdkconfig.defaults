# AI-Thinker ESP32-CAM (ESP32-S / ESP32-D0WDQ6 rev1+ / D0WD-V3, 4 MB flash, 4 MB SPI PSRAM)
CONFIG_IDF_TARGET="esp32"
CONFIG_ESP32_REV_MIN_1=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Tiny+big compact partition layout matching balax (tiny factory rescue stub + 3.19 MB ota_0)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../partitions_cam_compact.csv"

# Enable 4 MB SPI PSRAM (GPIO16 CS#, GPIO17 CLK) with Rev 1 [CPU-3.9] cache workaround
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_CACHE_WORKAROUND=y
CONFIG_SPIRAM_SPEED_40M=y

# Performance & RTOS tuning
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=200

# Slim network stack (IPv4-only, STA-only)
CONFIG_LWIP_IPV6=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
